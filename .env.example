PORT=3000
# Название сервиса в личном кабинете
APP_NAME=Brox Connect
# Публичный адрес сервиса (https:// в продакшене) — для ссылок на медиафайлы и secure-cookie
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Сколько номеров может подключить одна компания
MAX_CHANNELS_PER_ACCOUNT=5
# false — закрыть регистрацию новых компаний через сайт
ALLOW_SIGNUP=true
# Пауза между исходящими сообщениями одного номера, мс
SEND_DELAY_MIN_MS=1200
SEND_DELAY_MAX_MS=3000
LOG_LEVEL=info
